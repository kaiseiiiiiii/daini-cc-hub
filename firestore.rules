rules_version = '2';

// ============================================================================
// 第二CC Hub — Firestore セキュリティルール
// ----------------------------------------------------------------------------
// このアプリのソースコードは公開リポジトリに置かれており、誰でも読めます。
// URL・プロジェクトID・コレクション名・クエリの組み立て方は、すべて
// 攻撃者に既知であるという前提で書いています。
//
// つまり「画面に出していないから見えない」は防御になりません。
// 実データを守っているのは、このファイルだけです。
//
// 基本方針:
//   1. 未認証は一切読み書きできない
//   2. 認証済みでも、メンバーマスタ（許可リスト）に載っていなければ何も読めない
//   3. マスタ系（メンバー・チーム）はクライアントから書き換え不可
//   4. スプレッドシート同期データ（シフト・目標・実績）もクライアントから書き換え不可
//   5. 投稿の編集は作成者本人のみ、削除は本人または admin のみ
//   6. 物理削除は全面禁止（論理削除のみ。誰が消したかを追えるようにするため）
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 共通ヘルパー
    // ========================================================================

    // ログイン済みか。
    // email_verified も見ているのは、メールアドレスを許可リストの
    // 突き合わせキーに使っているため。未検証のアドレスを名乗られると
    // 許可リストの意味がなくなる。
    // （Googleログインは常に検証済みだが、将来ほかの認証方法を
    //   追加したときに穴が開かないよう明示しておく）
    function signedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    // 許可リストの突き合わせキー。
    // 大文字小文字の違いで許可リストをすり抜けられないよう、必ず小文字化する。
    // （メンバーマスタのドキュメントIDも小文字で登録すること）
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }

    // 許可リストに載っている有効なメンバーか。
    // ここが全コレクションの入口。これが false なら実データは1件も読めない。
    // active フラグを見ているのは、退職・異動時にドキュメントを消さずに
    // 無効化できるようにするため（過去の投稿の表示名を残すため）。
    function isMember() {
      return signedIn()
          && exists(memberPath())
          && get(memberPath()).data.active == true;
    }

    function me() {
      return get(memberPath()).data;
    }

    // 投稿に記録される作成者ID（例: "kaneko"）。
    // クライアントから送られてきた値ではなく、必ずマスタ側の値を使う。
    // そうしないと「他人になりすまして投稿する」を防げない。
    function myMemberId() {
      return me().memberId;
    }

    function isAdmin() {
      return isMember() && me().role == 'admin';
    }

    // 既存ドキュメントの作成者が自分か。
    function isAuthor() {
      return isMember() && resource.data.authorId == myMemberId();
    }

    // 今回の更新で変更されたフィールドが、許可した集合の中に収まっているか。
    // 「リアクションを押すだけ」のつもりの更新で、本文や作成者IDまで
    // 書き換えられるのを防ぐために使う。
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 「みんなが書き込むマップ」で、自分のキーしか触っていないことを検証する。
    //
    // reactions / votes / readBy は、いずれも memberId をキーにした
    // マップとして持つ。こうしておくと、この1行で
    // 「他人のリアクションを消す」「他人の名前で投票する」を封じられる。
    //
    // 逆向き（絵文字や選択肢IDをキーにして、中の memberId 配列を検証する）は
    // ルール言語に動的キーの取り出しもループも無いため実装できない。
    // データの向きは、この検証が書けるかどうかで決めている。
    function onlyMyKeyIn(field) {
      return request.resource.data[field].diff(resource.data[field])
               .affectedKeys().hasOnly([myMemberId()]);
    }

    // 上と同じ検証だが、既存ドキュメントにそのフィールドがまだ無い場合も許す。
    //
    // doneBy（チェックリストの完了記録）で必要になる。この機能より前に
    // 作られた掲示板の投稿には doneBy が無く、あとから期日を足して
    // チェックリストにすると「最初の1人」が空のマップに書き込むことになる。
    // onlyMyKeyIn は resource.data[field] を参照するため、その場合に
    // 評価エラーで拒否されてしまう。
    //
    // フィールドが無い場合は diff の相手がいないので、
    // 「新しく作るマップに自分のキーしか入っていないこと」を直接見る。
    function onlyMyKeyInOrNew(field) {
      return ( !resource.data.keys().hasAny([field])
               && request.resource.data[field].keys().hasOnly([myMemberId()]) )
          || ( resource.data.keys().hasAny([field])
               && onlyMyKeyIn(field) );
    }

    // チェックリストの期日と対象者の形を検証する。
    //
    // 期日は "YYYY-MM-DD" の文字列に限る。Timestamp にしないのは、
    // 時刻もタイムゾーンも意味を持たない「日付」であり、
    // 時差で1日ずれる事故を避けるため（GAS 側のカレンダー連携も
    // この文字列をそのまま終日予定の日付として使う）。
    //
    // フィールドが無い場合を許しているのは、チェックリストにしない
    // ふつうの連絡事項と、この機能より前に作られた投稿があるため。
    function validChecklist() {
      return ( !request.resource.data.keys().hasAny(['dueDate'])
               || request.resource.data.dueDate == null
               || ( request.resource.data.dueDate is string
                    && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') ) )
          && ( !request.resource.data.keys().hasAny(['checkTargets'])
               || request.resource.data.checkTargets == null
               || ( request.resource.data.checkTargets is list
                    && request.resource.data.checkTargets.size() <= 200 ) )
          // 人ごとの期日。{memberId: "YYYY-MM-DD"} の例外だけを持つ。
          //
          // 中の値の形はここでは検証できない（ルール言語にマップの値を
          // 走査する手段が無い）。書けるのは作成者だけなので、なりすましや
          // 他人による書き換えは別の条件で止まっている。壊れた日付が入った
          // 場合は、アプリと GAS の両方が「日付なし」として無視する。
          && ( !request.resource.data.keys().hasAny(['dueBy'])
               || request.resource.data.dueBy == null
               || ( request.resource.data.dueBy is map
                    && request.resource.data.dueBy.size() <= 200 ) );
    }

    // 作成者IDと作成日時は、いかなる更新でも変更させない。
    // これを許すと、他人の投稿を自分のものに書き換えたり、
    // 投稿日時を偽装したりできてしまう。
    function immutableOrigin() {
      return request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt;
    }

    // 論理削除（deleted: false → true）に該当する更新か。
    function isLogicalDelete() {
      return resource.data.deleted == false
          && request.resource.data.deleted == true;
    }

    // 論理削除の取り消し（復活）に該当する更新か。
    function isUndelete() {
      return resource.data.deleted == true
          && request.resource.data.deleted == false;
    }

    // 新規作成時に必ず満たしていてほしい共通条件。
    // 作成者IDをマスタ由来の値に固定し、削除済みフラグを立てた状態での
    // 作成（＝作成と同時に削除済みにして監査を濁す）を禁じる。
    function validNewPost() {
      return isMember()
          && request.resource.data.authorId == myMemberId()
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time;
    }


    // ========================================================================
    // メンバーマスタ（許可リスト）
    //   ドキュメントID = 小文字のメールアドレス
    //   フィールド: memberId, fullName, displayName, initial,
    //               team, jobTitle, role('member'|'admin'), order, active
    // ========================================================================
    match /members/{email} {

      // 【自分の1件だけ】は、メンバー判定より前に読めなければならない。
      // 「メンバーかどうかを判定するにはメンバーマスタを読む必要があるが、
      //   メンバーマスタを読むにはメンバーである必要がある」という
      //   鶏と卵を解くための例外。自分宛の1件に限定している。
      //
      // これにより、許可リスト外のGoogleアカウントでログインされても、
      // 読めるのは「存在しないドキュメント」だけで、
      // 他人のメールアドレス・氏名・権限は一切漏れない。
      allow get: if signedIn() && email == myEmail();

      // 一覧取得は正規メンバーのみ。
      // 投稿者の表示名やアバターを解決するためにアプリが全件読む。
      // ここを緩めると、社員のメールアドレス一覧がまるごと流出する。
      allow list: if isMember();

      // 許可リストの書き換えは、アプリ全体の乗っ取りと同義。
      // （自分を admin に昇格させる、他人を追加する、など）
      // クライアントからは絶対に触らせない。
      // 追加・変更は Firebase コンソール、または管理者権限を持つ
      // サーバー（Admin SDK）からのみ行う。
      allow create, update, delete: if false;
    }


    // ========================================================================
    // アイコン
    //   ドキュメントID = memberId
    //   フィールド: dataUrl（data:image/... の縮小画像）, updatedAt
    //
    // メンバーマスタとは別のコレクションにしている。
    // マスタは許可リストそのもので、本人にすら書かせたくない。
    // アイコンだけを分けておけば、マスタを閉じたまま
    // 「自分の分は自分で変えられる」を成立させられる。
    //
    // 画像は Storage ではなく Firestore に直接入れる。
    // 新しいプロジェクトでは Storage に課金プランが必要で、
    // 15人分のアイコンのためだけに増やす依存としては重いため。
    // その代わりクライアント側で必ず縮小してから書き込む。
    // ========================================================================
    match /avatars/{memberId} {
      allow read: if isMember();

      // 書けるのは自分の分だけ。admin は他人の分も設定できる
      // （入社時などに代わりに入れる運用があるため）。
      // サイズ上限を置いているのは、1MB のドキュメント上限すれすれの
      // 画像を入れられると、全員の読み込みが目に見えて遅くなるから。
      allow write: if isMember()
                   && (memberId == myMemberId() || isAdmin())
                   && (
                        request.method == 'delete' ||
                        (
                          request.resource.data.dataUrl is string
                          && request.resource.data.dataUrl.size() < 120000
                          && request.resource.data.dataUrl.matches('^data:image/(png|jpeg|webp);base64,.*')
                        )
                      );
    }


    // ========================================================================
    // チームマスタ
    //   ドキュメントID = チームID（例: "mgmt", "team_a", "team_b"）
    //   フィールド: label, order, colorKey
    // ========================================================================
    match /teams/{teamId} {
      // チーム名には社員の姓が含まれるため、メンバー限定で読ませる。
      allow read: if isMember();
      allow write: if false;
    }


    // ========================================================================
    // スプレッドシート同期データ（Phase 5 で GAS から書き込む）
    //   shifts     … 月別シフト表
    //   goals      … 目標値
    //   metrics    … 実績・生産性KPI
    //   syncStatus … 最終同期時刻・同期結果
    //
    // 【重要】ここに入るのは個人の成績と勤務予定、つまり本アプリで
    //         もっとも機微なデータ。クライアントからの書き込みを
    //         全面禁止し、書き込み経路を GAS のサービスアカウント
    //         1本に絞ることで、改ざん経路そのものを無くしている。
    //         （サービスアカウントは Admin 権限で動くため、
    //           このルールの評価対象外になる）
    // ========================================================================
    match /shifts/{docId=**} {
      allow read: if isMember();
      allow write: if false;
    }

    match /goals/{docId=**} {
      allow read: if isMember();
      allow write: if false;
    }

    match /metrics/{docId=**} {
      allow read: if isMember();
      allow write: if false;
    }

    match /syncStatus/{docId=**} {
      allow read: if isMember();
      allow write: if false;
    }


    // ========================================================================
    // フィード投稿
    //   フィールド: authorId, toMemberId, type, valueTag, text,
    //               reactions{memberId: [emoji]}, commentCount,
    //               createdAt, updatedAt, edited,
    //               deleted, deletedBy, deletedAt
    // ========================================================================
    match /feedPosts/{postId} {

      allow read: if isMember();

      allow create: if validNewPost()
                    && request.resource.data.edited == false
                    && request.resource.data.commentCount == 0
                    && request.resource.data.reactions.size() == 0;

      // 更新は「何を変えようとしているか」で分岐する。
      // UI 側で編集ボタンを出し分けるだけでは、開発者ツールから
      // 直接 update を投げられると防げないため、ここで担保する。
      allow update: if isMember()
                    && immutableOrigin()
                    && (
                         // ① リアクションの付け外しは全メンバーに許可。
                         //    他人の投稿にスタンプを押すのは正常な操作。
                         //    ただし触れるのは自分のキーだけ。
                         ( onlyChanged(['reactions']) && onlyMyKeyIn('reactions') )

                         // ② コメント数は非正規化した表示用の値。
                         //    コメントを1件足した／消したときの ±1 だけ許す。
                         //    任意の値に書き換えられると件数表示が壊れるため。
                      || ( onlyChanged(['commentCount'])
                           && ( request.resource.data.commentCount == resource.data.commentCount + 1
                             || request.resource.data.commentCount == resource.data.commentCount - 1 )
                           && request.resource.data.commentCount >= 0 )

                         // ③ 論理削除は作成者本人、または admin。
                         //    削除者と削除日時を必ず同時に記録させる。
                      || ( isLogicalDelete()
                           && (isAuthor() || isAdmin())
                           && request.resource.data.deletedBy == myMemberId()
                           && request.resource.data.deletedAt == request.time
                           && onlyChanged(['deleted','deletedBy','deletedAt']) )

                         // ④ 本文の編集は作成者本人のみ。
                         //    編集済みフラグを必ず立てさせる（改ざん感を避けるため
                         //    画面に「編集済み」を出す。フラグを立てずに
                         //    こっそり書き換えることを許さない）。
                      || ( isAuthor()
                           && !isLogicalDelete()
                           && !isUndelete()
                           && resource.data.deleted == false
                           && request.resource.data.edited == true
                           && onlyChanged(['text','type','valueTag','toMemberId',
                                           'edited','updatedAt']) )
                       );

      // 物理削除は禁止。論理削除のみ。
      // 「あの投稿誰が消した？」を後から追えるようにするため、
      // データそのものは必ず残す。
      allow delete: if false;

      // ----- コメント -----
      match /comments/{commentId} {
        allow read: if isMember();

        allow create: if validNewPost()
                      && request.resource.data.edited == false;

        allow update: if isMember()
                      && immutableOrigin()
                      && (
                           ( isLogicalDelete()
                             && (isAuthor() || isAdmin())
                             && request.resource.data.deletedBy == myMemberId()
                             && request.resource.data.deletedAt == request.time
                             && onlyChanged(['deleted','deletedBy','deletedAt']) )
                        || ( isAuthor()
                             && !isLogicalDelete()
                             && !isUndelete()
                             && resource.data.deleted == false
                             && request.resource.data.edited == true
                             && onlyChanged(['text','edited','updatedAt']) )
                         );

        allow delete: if false;
      }
    }


    // ========================================================================
    // 掲示板の添付画像
    //   ドキュメントID = 自動ID
    //   フィールド: authorId, dataUrl（data:image/... の縮小画像）,
    //               width, height, createdAt
    //
    // 投稿とは別のコレクションにしている。掲示板の一覧はログイン中ずっと
    // 購読しているので、画像を投稿と同じドキュメントに入れると、
    // タブを開くたびに全員が全部の画像を受け取ることになる。
    // 別にしておけば、画面に入ったものだけを1件ずつ取れる。
    //
    // アイコンと同様、Storage ではなく Firestore に直接入れる
    // （新しいプロジェクトでは Storage に課金プランが必要）。
    // その代わりクライアント側で必ず縮小してから書き込む。
    // ========================================================================
    match /boardImages/{imageId} {
      allow read: if isMember();

      allow create: if isMember()
                    && request.resource.data.authorId == myMemberId()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.dataUrl is string
                    // 1ドキュメント上限（約1MiB）に余裕を残して止める。
                    // アプリ側の BOARD_IMG_MAX と同じ値。
                    && request.resource.data.dataUrl.size() < 900000
                    && request.resource.data.dataUrl.matches('^data:image/(png|jpeg|webp);base64,.*')
                    && request.resource.data.width is int
                    && request.resource.data.height is int
                    && request.resource.data.width > 0
                    && request.resource.data.height > 0;

      // 差し替えは新しいドキュメントを作る。既存を書き換えさせない。
      // 「あの画像は誰がいつ貼ったか」を後から追えるようにするため、
      // 投稿から参照を外しても画像そのものは残す（削除も禁止）。
      allow update, delete: if false;
    }


    // ========================================================================
    // 掲示板（チェックリストを兼ねる）
    //   フィールド: authorId, title, body, category, pinned,
    //               readBy{memberId: 読んだ日時},
    //               reactions{memberId: [emoji]},
    //               createdAt, updatedAt, edited,
    //               deleted, deletedBy, deletedAt
    //
    //   チェックリストとして使う場合のみ付く（無い投稿が正常にある）:
    //               dueDate         … "YYYY-MM-DD"。これが入っていると
    //                                 チェックリストとして扱われる
    //               checkTargets    … 対象者の memberId 配列。
    //                                 null は「全員」を意味する
    //               dueBy{memberId: "YYYY-MM-DD"}
    //                               … 人ごとの期日。**全体と違う人の分だけ**
    //                                 入れる。入っていない人は dueDate に従う
    //               doneBy{memberId: 完了した日時}
    //
    //   添付画像を付けた場合のみ:
    //               imageId         … boardImages のドキュメントID
    //               imageW, imageH  … 読み込み前に縦横比の箱を置くための寸法。
    //                                 画像本体を取る前に必要なので、
    //                                 投稿側にも持たせている
    // ========================================================================
    match /boardPosts/{postId} {

      allow read: if isMember();

      allow create: if validNewPost()
                    && request.resource.data.edited == false
                    && validChecklist()
                    // 作成と同時に誰かを完了済みにするのを禁じる。
                    // 「配ったときには既に終わっていた」という記録を作れると、
                    // 完了状況そのものが信用できなくなる。
                    && ( !request.resource.data.keys().hasAny(['doneBy'])
                         || request.resource.data.doneBy.size() == 0 )
                    // 同様に、最初から他人のリアクションが付いた状態で作らせない。
                    && ( !request.resource.data.keys().hasAny(['reactions'])
                         || request.resource.data.reactions.size() == 0 );

      allow update: if isMember()
                    && immutableOrigin()
                    && (
                         // ① 既読の記録は全メンバーに許可。
                         //    ただし「自分の分だけ」を足せること。
                         //    他人を勝手に既読にして未読リストから消す、
                         //    という操作を防ぐ（Phase 3 の未読者表示が
                         //    信用できなくなるため）。
                         ( onlyChanged(['readBy']) && onlyMyKeyIn('readBy') )

                         // ② リアクションの付け外しは全メンバーに許可。
                         //    フィードと同じ扱い（他人の投稿にスタンプを
                         //    押すのは正常な操作）。触れるのは自分のキーだけ。
                         //    この機能より前の投稿には reactions が無いので、
                         //    フィールドが無い場合も許す版を使う。
                      || ( onlyChanged(['reactions']) && onlyMyKeyInOrNew('reactions') )

                         // ③ 完了チェックも同じ考え方で、触れるのは自分のキーだけ。
                         //    他人を勝手に完了にできると、未完了者への声かけという
                         //    この機能の目的そのものが成立しない。
                         //    admin も他人の分は変えられない（本人が終わったことは
                         //    本人しか知らないため。代わりに押す運用が必要になったら、
                         //    誰が代行したかを残せる形で別に設計する）。
                      || ( onlyChanged(['doneBy']) && onlyMyKeyInOrNew('doneBy') )

                         // ④ 論理削除は作成者本人、または admin。
                      || ( isLogicalDelete()
                           && (isAuthor() || isAdmin())
                           && request.resource.data.deletedBy == myMemberId()
                           && request.resource.data.deletedAt == request.time
                           && onlyChanged(['deleted','deletedBy','deletedAt']) )

                         // ⑤ 本文・期日・対象者・添付画像の編集は作成者本人のみ。
                         //    doneBy を含めていないので、期日を直すついでに
                         //    他人の完了記録を消すことはできない。
                      || ( isAuthor()
                           && !isLogicalDelete()
                           && !isUndelete()
                           && resource.data.deleted == false
                           && request.resource.data.edited == true
                           && validChecklist()
                           && onlyChanged(['title','body','category','pinned',
                                           'dueDate','checkTargets','dueBy',
                                           'imageId','imageW','imageH',
                                           'edited','updatedAt']) )
                       );

      allow delete: if false;
    }


    // ========================================================================
    // アンケート
    //   フィールド: authorId, title, multi, deadline, closed,
    //               options[{id, label}],
    //               votes{memberId: [optionId]},
    //               createdAt, updatedAt, edited,
    //               deleted, deletedBy, deletedAt
    //
    //   選択肢を id と label に分けているのは、label を直しても
    //   投票が失われないようにするため（Phase 4 の編集機能で必要）。
    //
    //   ※ 「誰がどの選択肢を選んだか」は画面に出さない方針だが、
    //     集計のため votes はメンバーから読める。
    //     つまり開発者ツールを開けば投票内容は見える。
    //     「画面に出さないだけ」という合意のもとでの設計である点に注意。
    //     完全な秘匿が必要になった場合は、votes をサブコレクション化し
    //     read を本人のみに絞ったうえで、集計値を別ドキュメントに
    //     サーバー側で書き出す構成に変更すること（Cloud Functions が要る）。
    // ========================================================================
    match /surveys/{surveyId} {

      allow read: if isMember();

      allow create: if validNewPost()
                    && request.resource.data.edited == false
                    && request.resource.data.closed == false
                    && request.resource.data.votes.size() == 0;

      allow update: if isMember()
                    && immutableOrigin()
                    && (
                         // ① 投票は全メンバーに許可。ただし自分のキーだけ。
                         //    締切済みの設問には投票させない。
                         ( onlyChanged(['votes'])
                           && onlyMyKeyIn('votes')
                           && resource.data.closed == false )

                         // ② 論理削除は作成者本人、または admin。
                      || ( isLogicalDelete()
                           && (isAuthor() || isAdmin())
                           && request.resource.data.deletedBy == myMemberId()
                           && request.resource.data.deletedAt == request.time
                           && onlyChanged(['deleted','deletedBy','deletedAt']) )

                         // ③ 設問の編集・締切操作は作成者本人のみ。
                      || ( isAuthor()
                           && !isLogicalDelete()
                           && !isUndelete()
                           && resource.data.deleted == false
                           && request.resource.data.edited == true
                           && onlyChanged(['title','options','multi','deadline',
                                           'closed','edited','updatedAt']) )
                       );

      allow delete: if false;
    }


    // ========================================================================
    // 明示的に定義していないコレクションは、すべて拒否。
    //
    // Firestore のルールは「どれか1つでも allow に当たれば許可」なので、
    // この記述が上のルールを打ち消すことはない。
    // 将来うっかり新しいコレクションを使い始めたときに、
    // ルールを書き忘れたまま公開されるのを防ぐための最終防壁。
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
